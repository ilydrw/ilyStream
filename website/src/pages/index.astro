---
import Layout from '../layouts/Layout.astro';
import { Image } from 'astro:assets';
import dashboardShot from '../assets/screenshots/dashboard-overview.png';
import chatShot from '../assets/screenshots/chat-hub-relay.png';
import audienceShot from '../assets/screenshots/audience-stats-profiles.png';
import studioShot from '../assets/screenshots/broadcast-studio.png';
import widgetsShot from '../assets/screenshots/widgets-overlays.png';
import alertsShot from '../assets/screenshots/alerts-routes.png';
import soundboardShot from '../assets/screenshots/soundboard.png';
import tiktokShot from '../assets/screenshots/tiktok-integration.png';
import spotifyShot from '../assets/screenshots/spotify-song-requests.png';
import aiShot from '../assets/screenshots/ai-cohost.png';
import healthShot from '../assets/screenshots/health-center.png';
import deskThingIcon from '../assets/deskthing.svg';
import { deskThingReleaseUrl, deskThingVersion, latestVersion, releaseUrl, setupUrl } from '../data/site';

const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const withBase = (path: string) => `${base}${path.replace(/^\/+/, '')}`;

const pillars = [
  {
    title: 'Go live from one control room',
    copy: 'Dashboard, scene health, broadcast output, and setup checks sit in one app instead of a stack of tabs.',
    href: 'docs/getting-started/',
    label: 'Start guide',
  },
  {
    title: 'Unify chat without losing context',
    copy: 'TikTok, Twitch, YouTube, and Kick messages flow into one hub with relay controls and per-platform outbound targeting.',
    href: 'docs/chat-relay/',
    label: 'Chat setup',
  },
  {
    title: 'Keep audience identity clean',
    copy: 'Merged profiles, primary account selection, badge ordering, AI command stats, and platform-aware sorting make the table usable.',
    href: 'docs/audience-stats/',
    label: 'Audience guide',
  },
  {
    title: 'Automate the stream room',
    copy: 'Alerts, widgets, TTS, OBS overlays, Philips Hue, Govee cloud/LAN/Bluetooth, Spotify, and DeskThing can all work together.',
    href: 'docs/alerts-widgets/',
    label: 'Automation guide',
  },
];

const setupGuides = [
  { title: 'Live platforms', href: 'docs/platforms/', copy: 'TikTok, Twitch, YouTube, and Kick setup with the exact credentials each service expects.' },
  { title: 'Chat Hub & relay', href: 'docs/chat-relay/', copy: 'Filter relayed messages, mirror only the targets you want, and test outbound chat safely.' },
  { title: 'Audience profiles', href: 'docs/audience-stats/', copy: 'Merge bad identities, set primary accounts, verify badges, and use status sorting.' },
  { title: 'Health Center', href: 'docs/health-center/', copy: 'Run platform checks, chat tests, event tests, and pre-stream readiness reviews.' },
  { title: 'Audio, TTS & commands', href: 'docs/audio-tts/', copy: 'Route audio, tune voices, and keep command messages from being read aloud.' },
  { title: 'Spotify requests', href: 'docs/spotify/', copy: 'Connect Spotify, enable song requests, and keep requested tracks out of TTS.' },
];

const screenshots = [
  { image: dashboardShot, title: 'Broadcast dashboard', alt: 'ilyStream broadcast dashboard overview.' },
  { image: studioShot, title: 'Broadcast studio', alt: 'ilyStream broadcast studio canvas and mixer.' },
  { image: chatShot, title: 'Unified chat and relay', alt: 'ilyStream unified chat hub with relay controls.' },
  { image: audienceShot, title: 'Audience stats and profiles', alt: 'ilyStream audience stats table with badges and profiles.' },
  { image: widgetsShot, title: 'Widgets and overlays', alt: 'ilyStream widgets and overlays page.' },
  { image: alertsShot, title: 'Live alerts', alt: 'ilyStream live alerts routing page.' },
  { image: soundboardShot, title: 'Audio deck', alt: 'ilyStream audio deck and soundboard page.' },
  { image: tiktokShot, title: 'TikTok integration', alt: 'ilyStream TikTok integration page.' },
  { image: spotifyShot, title: 'Spotify song requests', alt: 'ilyStream Spotify song requests page.' },
  { image: aiShot, title: 'AI co-host', alt: 'ilyStream AI co-host configuration page.' },
  { image: healthShot, title: 'Health Center', alt: 'ilyStream Health Center platform checkup.' },
];
---

<Layout
  active="home"
  title="ilyStream - Windows creator broadcast studio"
  description="ilyStream is a Windows broadcast studio for creators who want unified chat, platform setup, profiles, relay, overlays, TTS, audio routing, and smart-light automation in one place."
  image="images/dashboard-overview.png"
>
  <section class="hero">
    <div class="hero__media" aria-hidden="true">
      <Image src={dashboardShot} alt="" loading="eager" decoding="async" fetchpriority="high" />
    </div>
    <div class="hero__scrim"></div>

    <div class="container hero__inner">
      <p class="eyebrow">Windows preview · v{latestVersion}</p>
      <h1>The live creator control room.</h1>
      <p class="lede">
        ilyStream brings platform setup, unified chat, audience profiles, overlays,
        relay, TTS, audio routing, and smart-light automation into one focused Windows app.
      </p>
      <div class="hero__actions">
        <a class="button button--primary" href={setupUrl}>Download for Windows</a>
        <a class="button button--ghost" href={withBase('docs/getting-started/')}>Setup guide</a>
        <a class="button button--ghost" href={releaseUrl} rel="noopener">Release notes</a>
      </div>
      <p class="hero__meta">
        Current app release is v{latestVersion}. DeskThing companion latest is v{deskThingVersion}.
      </p>
    </div>
  </section>

  <section class="container status-strip" aria-label="Release status">
    <div>
      <span>Release</span>
      <strong>v{latestVersion}</strong>
    </div>
    <div>
      <span>Platform</span>
      <strong>Windows x64</strong>
    </div>
    <div>
      <span>Primary chats</span>
      <strong>TikTok · Twitch · YouTube · Kick</strong>
    </div>
    <div>
      <span>Companion</span>
      <strong>DeskThing v{deskThingVersion}</strong>
    </div>
  </section>

  <section class="container section">
    <div class="section__heading">
      <p class="eyebrow">What It Solves</p>
      <h2>Built for the messy middle of a real stream.</h2>
      <p>
        The point is not another dashboard. It is fewer places to check when chat,
        audio, overlays, lights, and profiles all need to behave at the same time.
      </p>
    </div>

    <div class="pillar-grid">
      {pillars.map((pillar) => (
        <a class="pillar-card" href={withBase(pillar.href)}>
          <h3>{pillar.title}</h3>
          <p>{pillar.copy}</p>
          <span>{pillar.label} <span aria-hidden="true">→</span></span>
        </a>
      ))}
    </div>
  </section>

  <section class="container section spotlight">
    <div class="spotlight__copy">
      <p class="eyebrow">Current Product</p>
      <h2>Cleaner setup, stronger diagnostics, better identity controls.</h2>
      <p>
        The website now documents the work that matters in the app: platform setup,
        YouTube manual chat mode, Kick webhooks, command-aware TTS, badge sorting,
        profile primaries, relay controls, soundboard control, Spotify requests,
        AI co-host settings, and Health Center checks.
      </p>
      <div class="spotlight__actions">
        <a class="button button--primary" href={withBase('docs/')}>Open all docs</a>
        <a class="button button--ghost" href={withBase('screens/')}>View screenshots</a>
      </div>
    </div>
    <div class="spotlight__media">
      <Image src={chatShot} alt="Unified chat and relay controls in ilyStream." loading="lazy" decoding="async" />
    </div>
  </section>

  <section class="container section">
    <div class="section__heading section__heading--row">
      <div>
        <p class="eyebrow">Setup Guides</p>
        <h2>Direct instructions for each moving part.</h2>
        <p>Every guide follows the same shape: prerequisites, exact app steps, verification, and fixes for common failures.</p>
      </div>
      <a class="button button--ghost" href={withBase('docs/')}>Browse docs</a>
    </div>

    <div class="docs-grid">
      {setupGuides.map((guide) => (
        <a class="doc-card" href={withBase(guide.href)}>
          <h3>{guide.title}</h3>
          <p>{guide.copy}</p>
          <span>Read guide <span aria-hidden="true">→</span></span>
        </a>
      ))}
    </div>
  </section>

  <section class="container section">
    <div class="section__heading section__heading--row">
      <div>
        <p class="eyebrow">Screenshots</p>
        <h2>Fresh captures from the actual app.</h2>
        <p>These are current desktop captures, so the site shows the real workflows users will see.</p>
      </div>
      <a class="button button--ghost" href={withBase('screens/')}>Open gallery</a>
    </div>

    <div class="screens-strip">
      {screenshots.slice(0, 5).map((shot, index) => (
        <a class:list={['screens-strip__item', { 'screens-strip__item--lead': index === 0 }]} href={withBase('screens/')}>
          <Image src={shot.image} alt={shot.alt} loading="lazy" decoding="async" />
          <span>{shot.title}</span>
        </a>
      ))}
    </div>
  </section>

  <section class="container section companion">
    <div>
      <p class="eyebrow">Companion</p>
      <h2>DeskThing stays documented separately.</h2>
      <p>
        The Windows app and DeskThing companion release on different schedules.
        The download page and guide now use the correct companion version instead of guessing.
      </p>
      <div class="companion__actions">
        <a class="button button--ghost" href={withBase('docs/deskthing/')}>
          Setup guide
          <Image src={deskThingIcon} alt="" width="18" height="18" loading="lazy" />
        </a>
        <a class="button button--ghost" href={deskThingReleaseUrl} rel="noopener">Companion releases</a>
      </div>
    </div>
    <div class="release-card">
      <span>Windows app</span>
      <strong>v{latestVersion}</strong>
      <span>DeskThing companion</span>
      <strong>v{deskThingVersion}</strong>
    </div>
  </section>

  <section class="container section cta-band">
    <div>
      <h2>Ready to clean up the stream rig?</h2>
      <p>Install the Windows app, then walk through platform setup and Health Center before going live.</p>
    </div>
    <div class="cta-band__actions">
      <a class="button button--primary" href={setupUrl}>Download v{latestVersion}</a>
      <a class="button button--ghost" href={withBase('docs/getting-started/')}>Start setup</a>
    </div>
  </section>
</Layout>

<style>
  .hero {
    position: relative;
    min-height: clamp(620px, 78svh, 820px);
    overflow: hidden;
    border-bottom: 1px solid var(--line);
  }

  .hero__media {
    position: absolute;
    inset: 0;
  }

  .hero__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 58% 50%;
    opacity: 0.54;
  }

  .hero__scrim {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(90deg, rgba(10, 12, 16, 0.96) 0%, rgba(10, 12, 16, 0.78) 42%, rgba(10, 12, 16, 0.42) 100%),
      linear-gradient(0deg, rgba(10, 12, 16, 0.95) 0%, rgba(10, 12, 16, 0) 46%);
  }

  .hero__inner {
    position: relative;
    padding: clamp(92px, 14svh, 150px) 0 80px;
  }

  .hero h1 {
    max-width: 13ch;
    margin-top: 16px;
    font-size: clamp(3rem, 7vw, 6.2rem);
    line-height: 0.95;
  }

  .lede {
    max-width: 60ch;
    margin-top: 24px;
    color: var(--muted);
    font-size: clamp(1.08rem, 1.7vw, 1.28rem);
  }

  .hero__actions,
  .spotlight__actions,
  .companion__actions,
  .cta-band__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  .hero__actions { margin-top: 34px; }
  .hero__meta { margin-top: 18px; color: var(--quiet); }

  .status-strip {
    margin-top: 32px;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--bg-raised);
    overflow: hidden;
  }

  .status-strip div {
    min-height: 84px;
    padding: 18px 20px;
    border-right: 1px solid var(--line);
  }

  .status-strip div:last-child { border-right: 0; }

  .status-strip span {
    display: block;
    color: var(--quiet);
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .status-strip strong {
    display: block;
    margin-top: 7px;
    font-size: 1.05rem;
  }

  .section { padding-top: 92px; }

  .section__heading {
    max-width: 760px;
    margin-bottom: 34px;
  }

  .section__heading--row {
    max-width: none;
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 24px;
  }

  .section__heading h2,
  .spotlight h2,
  .companion h2,
  .cta-band h2 {
    margin-top: 12px;
    font-size: clamp(1.9rem, 3.4vw, 2.8rem);
  }

  .section__heading p:not(.eyebrow),
  .spotlight p,
  .companion p,
  .cta-band p {
    margin-top: 14px;
    color: var(--muted);
    font-size: 1.05rem;
  }

  .pillar-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 14px;
  }

  .pillar-card,
  .doc-card,
  .screens-strip__item,
  .release-card,
  .spotlight__media {
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--bg-raised);
    box-shadow: var(--shadow-card);
  }

  .pillar-card,
  .doc-card {
    min-height: 230px;
    padding: 24px;
    color: var(--text);
    display: flex;
    flex-direction: column;
    transition: transform 180ms ease, border-color 180ms ease;
  }

  .pillar-card:hover,
  .doc-card:hover,
  .screens-strip__item:hover {
    transform: translateY(-2px);
    border-color: rgba(37, 199, 255, 0.45);
  }

  .pillar-card h3,
  .doc-card h3 { font-size: 1.2rem; }

  .pillar-card p,
  .doc-card p { color: var(--muted); margin-top: 10px; }

  .pillar-card span,
  .doc-card span {
    margin-top: auto;
    padding-top: 18px;
    color: var(--cyan);
    font-weight: 800;
  }

  .spotlight,
  .companion,
  .cta-band {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(360px, 1.1fr);
    align-items: center;
    gap: 44px;
  }

  .spotlight__actions { margin-top: 26px; }

  .spotlight__media {
    overflow: hidden;
  }

  .spotlight__media img {
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    display: block;
  }

  .docs-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 14px;
  }

  .screens-strip {
    display: grid;
    grid-template-columns: 1.5fr repeat(4, 1fr);
    gap: 12px;
  }

  .screens-strip__item {
    position: relative;
    overflow: hidden;
    color: var(--text);
    aspect-ratio: 16 / 10;
    transition: transform 180ms ease, border-color 180ms ease;
  }

  .screens-strip__item--lead {
    aspect-ratio: 16 / 9;
  }

  .screens-strip__item img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .screens-strip__item span {
    position: absolute;
    left: 12px;
    right: 12px;
    bottom: 12px;
    padding: 8px 10px;
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 8px;
    background: rgba(10, 12, 16, 0.7);
    color: var(--text);
    font-weight: 800;
    font-size: 0.84rem;
    backdrop-filter: blur(10px);
  }

  .release-card {
    padding: 30px;
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 18px;
    align-items: center;
  }

  .release-card span {
    color: var(--muted);
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-size: 0.76rem;
  }

  .release-card strong {
    font-size: 2rem;
    color: var(--cyan);
  }

  .cta-band {
    margin-bottom: 64px;
    padding: 34px;
    border: 1px solid rgba(37, 199, 255, 0.28);
    border-radius: 16px;
    background:
      radial-gradient(600px 220px at 20% 0%, rgba(37, 199, 255, 0.18), transparent 70%),
      linear-gradient(180deg, rgba(167, 131, 255, 0.1), rgba(255, 255, 255, 0)),
      var(--bg-raised);
  }

  @media (max-width: 1100px) {
    .pillar-grid,
    .docs-grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .screens-strip {
      grid-template-columns: repeat(3, 1fr);
    }

    .screens-strip__item--lead {
      grid-column: span 3;
      aspect-ratio: 16 / 7;
    }
  }

  @media (max-width: 760px) {
    .status-strip,
    .pillar-grid,
    .docs-grid,
    .spotlight,
    .companion,
    .cta-band {
      grid-template-columns: 1fr;
    }

    .status-strip div,
    .status-strip div:last-child {
      border-right: 0;
      border-bottom: 1px solid var(--line);
    }

    .status-strip div:last-child {
      border-bottom: 0;
    }

    .section {
      padding-top: 64px;
    }

    .section__heading--row {
      flex-direction: column;
      align-items: flex-start;
    }

    .screens-strip {
      grid-template-columns: 1fr 1fr;
    }

    .screens-strip__item--lead {
      grid-column: span 2;
      aspect-ratio: 16 / 9;
    }
  }
</style>

---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import pairPreview from '../assets/deskthing-pair-tight.png';
import {
  deskThingReleaseUrl,
  deskThingVersion,
  deskThingZipUrl,
  latestVersion,
  setupUrl,
} from '../data/site';

const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const withBase = (path: string) => `${base}${path.replace(/^\/+/, '')}`;

const capabilities = [
  {
    number: '01',
    title: 'Soundboard at hand',
    copy: 'Fire sounds, revisit recent clips, page with the wheel, and stop every audio source with one panic control.',
  },
  {
    number: '02',
    title: 'Actions without alt-tabbing',
    copy: 'Run the actions already configured in ilyStream, including media controls and your own deck workflows.',
  },
  {
    number: '03',
    title: 'Chat built for a glance',
    copy: 'Follow TikTok, Twitch, YouTube, and Kick with platform color, avatars, roles, badges, events, and scrollback.',
  },
  {
    number: '04',
    title: 'Live pulse that stays visible',
    copy: 'Viewers, recording, TTS, Spotify, recently fired sounds, connection health, and stream stats stay within reach.',
  },
];

const controls = [
  { input: '1 · 2 · 3 · 4', action: 'Jump to Board, Actions, Stats, or Chat' },
  { input: 'Wheel', action: 'Page tiles or scroll chat and live stats' },
  { input: 'Touch', action: 'Fire a tile, switch tabs, control media' },
  { input: 'Arrow keys', action: 'Move between pages on alternate hardware' },
];
---

<Layout
  active="companion"
  title="ilyStream DeskThing companion"
  description="Turn DeskThing-compatible hardware into a tactile ilyStream companion for soundboard controls, stream actions, live chat, audience stats, Spotify, TTS, and recording status."
  image="images/dashboard-overview.png"
>
  <section class="companion-hero">
    <div class="companion-hero__glow" aria-hidden="true"></div>
    <div class="container companion-hero__grid">
      <div class="companion-hero__copy">
        <p class="eyebrow">DeskThing companion · v{deskThingVersion}</p>
        <h1>Your stream,<br /><span>within reach.</span></h1>
        <p class="lede">
          Give compatible hardware a real job on your desk. ilyStream Deck turns it into a tactile
          soundboard, action panel, live chat, audience monitor, and session status display.
        </p>
        <div class="hero-actions">
          <a class="button button--primary" href={deskThingZipUrl} rel="noopener">Download companion</a>
          <a class="button button--ghost" href={withBase('docs/deskthing/')}>Pairing guide</a>
        </div>
        <div class="hero-proof" aria-label="Companion requirements">
          <span><i></i> Local-network pairing</span>
          <span><i></i> DeskThing 0.11+</span>
          <span><i></i> ilyStream v{latestVersion}</span>
        </div>
      </div>

      <div class="device-stage" aria-label="Preview of the ilyStream DeskThing companion">
        <div class="device-stage__bar">
          <div class="device-brand"><span class="device-mark">♥</span><strong>ilyStream Deck</strong></div>
          <div class="device-live"><i></i> Live sync</div>
          <span class="device-time">10:42</span>
        </div>
        <div class="device-tabs">
          <span class="active">Board <b>12</b></span><span>Actions <b>8</b></span><span>Stats <b>248</b></span><span>Chat <b>34</b></span>
        </div>
        <div class="device-grid">
          <div class="device-tile active"><em>🎉</em><strong>Air horn</strong><small>Soundboard</small></div>
          <div class="device-tile"><em>👏</em><strong>Applause</strong><small>Soundboard</small></div>
          <div class="device-tile"><em>✨</em><strong>Sparkle</strong><small>Soundboard</small></div>
          <div class="device-tile"><em>😂</em><strong>Laugh</strong><small>Soundboard</small></div>
          <div class="device-tile"><em>🚨</em><strong>Siren</strong><small>Soundboard</small></div>
          <div class="device-tile"><em>🥁</em><strong>Drum roll</strong><small>Soundboard</small></div>
          <div class="device-tile"><em>💜</em><strong>Love</strong><small>Soundboard</small></div>
          <div class="device-tile"><em>🔔</em><strong>Bell</strong><small>Soundboard</small></div>
        </div>
        <div class="device-strip"><span>⚡</span><div><strong>Ready</strong><small>12 sounds · 8 actions</small></div><b>248 watching</b><b class="rec">● REC</b></div>
      </div>
    </div>
  </section>

  <section class="container section">
    <div class="section-heading">
      <p class="eyebrow">One compact surface</p>
      <h2>Less reaching for the mouse.<br />More attention on the stream.</h2>
      <p>The companion mirrors the useful parts of ilyStream without trying to squeeze a desktop app onto an 800 × 480 display.</p>
    </div>
    <div class="capability-grid">
      {capabilities.map((capability) => (
        <article class="capability-card">
          <span>{capability.number}</span>
          <h3>{capability.title}</h3>
          <p>{capability.copy}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="container section interaction">
    <div class="interaction__copy">
      <p class="eyebrow">Built for the hardware</p>
      <h2>Touch, buttons, and wheel all have a purpose.</h2>
      <p>
        The interface is designed around fast muscle memory. Physical controls map to the same destinations every time,
        while touch remains available for precise actions.
      </p>
      <div class="control-map">
        {controls.map((control) => (
          <div><kbd>{control.input}</kbd><span>{control.action}</span></div>
        ))}
      </div>
    </div>
    <div class="interaction__panel">
      <div class="signal-head"><span>Live session</span><strong><i></i> Connected</strong></div>
      <div class="signal-main"><small>Current viewers</small><strong>248</strong><span>updated now</span></div>
      <div class="signal-grid">
        <div><small>Likes</small><strong>12.8K</strong></div>
        <div><small>Gifts</small><strong>43</strong></div>
        <div><small>Follows</small><strong>186</strong></div>
        <div><small>Subs</small><strong>27</strong></div>
      </div>
    </div>
  </section>

  <section class="container section pairing">
    <div class="pairing__preview">
      <Image src={pairPreview} alt="DeskThing pairing screen for an ilyStream LAN address and six-digit code." loading="lazy" decoding="async" />
    </div>
    <div class="pairing__copy">
      <p class="eyebrow">Private by design</p>
      <h2>Pair once. Keep the token off the device UI.</h2>
      <p>
        The DeskThing server module runs on your PC. It holds the token, talks to ilyStream over your LAN,
        and forwards only the catalog and live state the companion needs.
      </p>
      <ol>
        <li><span>1</span><div><strong>Install both apps</strong><p>Run ilyStream on the stream PC and add the companion zip to DeskThing.</p></div></li>
        <li><span>2</span><div><strong>Create a pair code</strong><p>Open Hardware → DeskThing in ilyStream and generate a six-digit code.</p></div></li>
        <li><span>3</span><div><strong>Enter the LAN address</strong><p>The companion saves the approved connection and starts syncing automatically.</p></div></li>
      </ol>
      <a class="text-link" href={withBase('docs/deskthing/')}>Read the full pairing guide <span aria-hidden="true">→</span></a>
    </div>
  </section>

  <section class="container section architecture">
    <div class="section-heading">
      <p class="eyebrow">Resilient bridge</p>
      <h2>Made to recover when the network blinks.</h2>
    </div>
    <div class="architecture-flow" aria-label="Companion connection architecture">
      <div><small>On your desk</small><strong>DeskThing display</strong><span>No direct API credentials</span></div>
      <i aria-hidden="true">↔</i>
      <div><small>On your PC</small><strong>Companion bridge</strong><span>Authenticated proxy + reconnect</span></div>
      <i aria-hidden="true">↔</i>
      <div><small>On your PC</small><strong>ilyStream</strong><span>Catalog + live event stream</span></div>
    </div>
  </section>

  <section class="container section final-cta">
    <div>
      <p class="eyebrow">Ready when you are</p>
      <h2>Put the stream controls where your hand already is.</h2>
      <p>Install the Windows app, add the DeskThing companion, and pair them over your local network.</p>
    </div>
    <div class="final-cta__actions">
      <a class="button button--primary" href={deskThingZipUrl} rel="noopener">Get companion v{deskThingVersion}</a>
      <a class="button button--ghost" href={setupUrl}>Get ilyStream v{latestVersion}</a>
      <a class="text-link" href={deskThingReleaseUrl} rel="noopener">Release notes →</a>
    </div>
  </section>
</Layout>

<style>
  .companion-hero { position: relative; overflow: hidden; padding: 104px 0 86px; border-bottom: 1px solid var(--line); }
  .companion-hero__glow { position: absolute; inset: -10% -20% auto 40%; height: 620px; background: radial-gradient(circle, rgba(167, 131, 255, .2), rgba(37, 199, 255, .08) 42%, transparent 72%); filter: blur(10px); pointer-events: none; }
  .companion-hero__grid { position: relative; display: grid; grid-template-columns: .9fr 1.25fr; align-items: center; gap: 62px; }
  .companion-hero h1 { margin-top: 14px; max-width: 11ch; font-size: clamp(3.4rem, 6.5vw, 6.4rem); line-height: .92; }
  .companion-hero h1 span { color: transparent; background: var(--grad-brand); background-clip: text; -webkit-background-clip: text; }
  .lede { margin-top: 24px; max-width: 57ch; color: var(--muted); font-size: 1.14rem; }
  .hero-actions, .final-cta__actions { display: flex; flex-wrap: wrap; align-items: center; gap: 10px; margin-top: 30px; }
  .hero-proof { display: flex; flex-wrap: wrap; gap: 16px; margin-top: 22px; color: var(--quiet); font-size: .82rem; font-weight: 700; }
  .hero-proof span { display: inline-flex; align-items: center; gap: 7px; }
  .hero-proof i, .device-live i, .signal-head i { width: 7px; height: 7px; border-radius: 50%; background: var(--green); box-shadow: 0 0 12px rgba(36, 209, 139, .65); }

  .device-stage { position: relative; min-width: 0; padding: 14px; border: 1px solid rgba(255,255,255,.16); border-radius: 26px; background: #07090d; box-shadow: 0 40px 90px rgba(0,0,0,.5), 0 0 0 8px rgba(255,255,255,.025); transform: perspective(1200px) rotateY(-3deg) rotateX(1deg); }
  .device-stage::before { content: ''; position: absolute; inset: -1px; z-index: -1; border-radius: inherit; background: var(--grad-brand); opacity: .28; filter: blur(20px); }
  .device-stage__bar, .device-tabs, .device-strip { display: flex; align-items: center; }
  .device-stage__bar { min-height: 48px; justify-content: space-between; gap: 14px; padding: 0 10px 10px; }
  .device-brand { display: flex; align-items: center; gap: 9px; font-size: .82rem; }
  .device-mark { width: 28px; height: 28px; display: grid; place-items: center; border-radius: 7px; background: var(--grad-brand); color: #07090d; }
  .device-live { display: inline-flex; align-items: center; gap: 6px; color: #bbf7d0; font-size: .7rem; font-weight: 800; }
  .device-time { color: var(--muted); font-weight: 800; font-variant-numeric: tabular-nums; }
  .device-tabs { gap: 4px; padding: 4px; border: 1px solid var(--line); border-radius: 8px; background: #101319; }
  .device-tabs span { flex: 1; display: flex; align-items: center; justify-content: center; gap: 6px; min-height: 30px; border-radius: 6px; color: var(--quiet); font-size: .66rem; font-weight: 800; }
  .device-tabs span.active { color: var(--text); background: rgba(37,199,255,.13); box-shadow: inset 0 0 0 1px rgba(37,199,255,.35); }
  .device-tabs b { padding: 2px 5px; border-radius: 999px; background: #080a0e; font-size: .6rem; }
  .device-grid { display: grid; grid-template-columns: repeat(4, 1fr); grid-template-rows: repeat(2, 104px); gap: 7px; padding: 8px 0; }
  .device-tile { position: relative; min-width: 0; display: grid; place-items: center; align-content: center; gap: 5px; overflow: hidden; border: 1px solid var(--line); border-radius: 8px; background: linear-gradient(180deg, rgba(255,255,255,.04), transparent), #14171d; }
  .device-tile::before { content: ''; position: absolute; inset: 0; border-top: 2px solid var(--cyan); opacity: .7; }
  .device-tile.active { border-color: rgba(37,199,255,.7); background: linear-gradient(180deg, rgba(37,199,255,.16), transparent), #14171d; }
  .device-tile em { font-style: normal; font-size: 1.45rem; }
  .device-tile strong { max-width: 90%; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-size: .7rem; }
  .device-tile small { color: var(--quiet); font-size: .5rem; font-weight: 800; text-transform: uppercase; }
  .device-strip { gap: 9px; min-height: 46px; padding: 6px 9px; border-top: 1px solid var(--line); background: #101319; }
  .device-strip > span { width: 30px; height: 30px; display: grid; place-items: center; border: 1px solid var(--line); border-radius: 7px; }
  .device-strip div { flex: 1; display: grid; line-height: 1.1; }
  .device-strip strong { font-size: .72rem; }
  .device-strip small { margin-top: 3px; color: var(--quiet); font-size: .58rem; }
  .device-strip > b { padding: 6px 8px; border: 1px solid var(--line); border-radius: 7px; color: var(--muted); font-size: .58rem; }
  .device-strip > b.rec { color: #fecdd3; border-color: rgba(255,92,122,.38); }

  .section { padding-top: 96px; }
  .section-heading { max-width: 800px; }
  .section-heading h2, .interaction h2, .pairing h2, .final-cta h2 { margin-top: 12px; font-size: clamp(2rem, 4vw, 3.4rem); }
  .section-heading > p:not(.eyebrow), .interaction__copy > p:not(.eyebrow), .pairing__copy > p:not(.eyebrow), .final-cta p:not(.eyebrow) { margin-top: 16px; max-width: 68ch; color: var(--muted); font-size: 1.05rem; }
  .capability-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 14px; margin-top: 38px; }
  .capability-card { min-height: 270px; padding: 26px; border: 1px solid var(--line); border-radius: var(--radius); background: linear-gradient(180deg, rgba(255,255,255,.035), transparent), var(--bg-raised); box-shadow: var(--shadow-card); }
  .capability-card > span { color: var(--cyan); font-size: .72rem; font-weight: 900; letter-spacing: .14em; }
  .capability-card h3 { margin-top: 54px; font-size: 1.3rem; }
  .capability-card p { margin-top: 12px; color: var(--muted); }

  .interaction, .pairing { display: grid; grid-template-columns: 1fr 1fr; align-items: center; gap: 64px; }
  .control-map { display: grid; gap: 1px; margin-top: 28px; overflow: hidden; border: 1px solid var(--line); border-radius: var(--radius); background: var(--line); }
  .control-map div { display: grid; grid-template-columns: 130px 1fr; align-items: center; gap: 16px; min-height: 58px; padding: 10px 14px; background: var(--bg-raised); }
  .control-map kbd { width: fit-content; padding: 5px 9px; border: 1px solid var(--line-strong); border-bottom-width: 3px; border-radius: 7px; background: var(--bg-soft); color: var(--text); font: 800 .78rem/1 'Inter var', Inter, sans-serif; }
  .control-map span { color: var(--muted); font-size: .92rem; }
  .interaction__panel { padding: 22px; border: 1px solid rgba(37,199,255,.32); border-radius: 18px; background: radial-gradient(500px 240px at 20% 0%, rgba(37,199,255,.13), transparent 70%), var(--bg-raised); box-shadow: var(--shadow-card); }
  .signal-head { display: flex; justify-content: space-between; color: var(--muted); font-size: .78rem; font-weight: 800; text-transform: uppercase; letter-spacing: .08em; }
  .signal-head strong { display: inline-flex; align-items: center; gap: 7px; color: #bbf7d0; font-size: .7rem; }
  .signal-main { display: grid; grid-template-columns: 1fr auto; align-items: end; margin-top: 36px; padding-bottom: 26px; border-bottom: 1px solid var(--line); }
  .signal-main small { grid-column: 1 / -1; color: var(--cyan); font-weight: 800; }
  .signal-main strong { font-size: clamp(4rem, 8vw, 6.6rem); line-height: .9; font-variant-numeric: tabular-nums; }
  .signal-main span { color: var(--quiet); font-size: .8rem; }
  .signal-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 1px; margin-top: 1px; background: var(--line); }
  .signal-grid div { display: grid; gap: 7px; padding: 20px; background: var(--bg-raised); }
  .signal-grid small { color: var(--muted); }
  .signal-grid strong { font-size: 1.55rem; }

  .pairing__preview { padding: 22px; border: 1px solid var(--line); border-radius: 18px; background: #090b0f; box-shadow: var(--shadow-card); }
  .pairing__preview img { width: 100%; border-radius: 10px; }
  .pairing ol { display: grid; gap: 18px; margin: 26px 0 0; padding: 0; list-style: none; }
  .pairing li { display: grid; grid-template-columns: 38px 1fr; gap: 14px; }
  .pairing li > span { width: 38px; height: 38px; display: grid; place-items: center; border: 1px solid rgba(37,199,255,.36); border-radius: 10px; background: rgba(37,199,255,.09); color: var(--cyan); font-weight: 900; }
  .pairing li strong { font-size: 1rem; }
  .pairing li p { margin-top: 4px; color: var(--muted); }
  .text-link { display: inline-flex; align-items: center; gap: 7px; margin-top: 24px; color: var(--cyan); font-weight: 800; }
  .text-link span { transition: transform 150ms ease; }
  .text-link:hover span { transform: translateX(4px); }

  .architecture { padding-bottom: 12px; }
  .architecture-flow { display: grid; grid-template-columns: 1fr auto 1fr auto 1fr; align-items: center; gap: 18px; margin-top: 34px; }
  .architecture-flow > div { min-height: 150px; display: grid; align-content: center; gap: 8px; padding: 24px; border: 1px solid var(--line); border-radius: var(--radius); background: var(--bg-raised); }
  .architecture-flow small { color: var(--cyan); font-weight: 800; text-transform: uppercase; letter-spacing: .1em; }
  .architecture-flow strong { font-size: 1.2rem; }
  .architecture-flow span { color: var(--muted); }
  .architecture-flow > i { color: var(--quiet); font-style: normal; font-size: 1.4rem; }

  .final-cta { margin-bottom: 72px; padding: 40px; border: 1px solid rgba(37,199,255,.3); border-radius: 18px; background: radial-gradient(620px 240px at 12% 0%, rgba(37,199,255,.16), transparent 70%), linear-gradient(135deg, rgba(167,131,255,.1), transparent), var(--bg-raised); }
  .final-cta { display: grid; grid-template-columns: 1.2fr .8fr; align-items: center; gap: 40px; }
  .final-cta__actions { justify-content: flex-end; margin-top: 0; }
  .final-cta__actions .text-link { margin-top: 0; padding: 10px; }

  @media (max-width: 1050px) {
    .companion-hero__grid, .interaction, .pairing { grid-template-columns: 1fr; }
    .companion-hero__copy { max-width: 760px; }
    .device-stage { max-width: 780px; transform: none; }
    .capability-grid { grid-template-columns: 1fr 1fr; }
    .pairing__preview { order: 2; }
  }
  @media (max-width: 760px) {
    .companion-hero { padding: 72px 0 56px; }
    .section { padding-top: 68px; }
    .capability-grid, .final-cta { grid-template-columns: 1fr; }
    .capability-card { min-height: 220px; }
    .capability-card h3 { margin-top: 34px; }
    .architecture-flow { grid-template-columns: 1fr; }
    .architecture-flow > i { transform: rotate(90deg); justify-self: center; }
    .final-cta__actions { justify-content: flex-start; }
    .device-stage { padding: 10px; overflow: hidden; }
    .device-grid { grid-template-columns: repeat(2, 1fr); grid-template-rows: repeat(2, 88px); }
    .device-tile:nth-child(n + 5) { display: none; }
    .device-tabs span { font-size: .56rem; }
    .device-strip > b { display: none; }
  }
  @media (max-width: 480px) {
    .companion-hero h1 { font-size: 3.2rem; }
    .capability-grid { grid-template-columns: 1fr; }
    .control-map div { grid-template-columns: 1fr; gap: 8px; }
    .signal-main strong { font-size: 4rem; }
    .final-cta { padding: 26px; }
  }
</style>

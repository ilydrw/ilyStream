---
import Layout from '../../layouts/Layout.astro';

const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const withBase = (path: string) => `${base}${path.replace(/^\/+/, '')}`;

const sections = [
  {
    label: 'Start here',
    cards: [
      {
        title: 'Getting started',
        copy: 'Install ilyStream, learn the main workspaces, run Health Center, and get ready for your first live session.',
        href: 'docs/getting-started/',
        kicker: 'Tutorial',
        time: '8 min',
      },
      {
        title: 'Health Center',
        copy: 'Use the app-wide readiness screen to test chat paths, relay status, event routing, platform health, and current risks.',
        href: 'docs/health-center/',
        kicker: 'Diagnostics',
        time: '6 min',
      },
    ],
  },
  {
    label: 'Live platforms',
    cards: [
      {
        title: 'TikTok, Twitch, YouTube & Kick',
        copy: 'Set up platform connections, outbound chat capability, live chat discovery, Kick webhooks, and YouTube manual fallback mode.',
        href: 'docs/platforms/',
        kicker: 'Connections',
        time: '14 min',
      },
      {
        title: 'Chat Hub & relay',
        copy: 'Configure the unified feed, platform filters, automatic relay, manual outbound replies, and feedback-loop protection.',
        href: 'docs/chat-relay/',
        kicker: 'Unified chat',
        time: '8 min',
      },
      {
        title: 'X Composer',
        copy: 'Use X as a manual go-live composer, or unlock automatic posts only if you bring a paid X API plan.',
        href: 'docs/x-composer/',
        kicker: 'Optional',
        time: '6 min',
      },
    ],
  },
  {
    label: 'Audience & automation',
    cards: [
      {
        title: 'Audience profiles & stats',
        copy: 'Merge bad identities, set primary accounts, fix avatars, verify platform badges, and keep rankings readable.',
        href: 'docs/audience-stats/',
        kicker: 'Audience',
        time: '10 min',
      },
      {
        title: 'Alerts & widgets',
        copy: 'Create browser-source widgets, alert routes, media assets, platform filters, and safe test events.',
        href: 'docs/alerts-widgets/',
        kicker: 'Overlays',
        time: '10 min',
      },
      {
        title: 'Audio routing & TTS',
        copy: 'Set up the broadcast mix, configure TTS, Voice FX, soundboard output, and command-aware filtering.',
        href: 'docs/audio-tts/',
        kicker: 'Production audio',
        time: '10 min',
      },
      {
        title: 'Spotify setup',
        copy: 'Create a Spotify Developer app, add the ilyStream redirect URI, connect your account, and enable song requests.',
        href: 'docs/spotify/',
        kicker: 'Music integration',
        time: '9 min',
      },
    ],
  },
  {
    label: 'Smart lights',
    cards: [
      {
        title: 'Philips Hue',
        copy: 'Pair the Hue Bridge with ilyStream, generate a developer username, and select fixtures for chat reactions.',
        href: 'docs/philips-hue/',
        kicker: 'Smart lights',
        time: '8 min',
      },
      {
        title: 'Govee',
        copy: 'Connect Govee fixtures with cloud, LAN, and Bluetooth paths, then use them in event reactions.',
        href: 'docs/govee/',
        kicker: 'Smart lights',
        time: '8 min',
      },
    ],
  },
  {
    label: 'Broadcast & companion',
    cards: [
      {
        title: 'OBS browser sources',
        copy: 'Add ilyStream widgets and alerts to OBS as transparent browser sources so they composite cleanly with your scenes.',
        href: 'docs/obs/',
        kicker: 'Browser sources',
        time: '7 min',
      },
      {
        title: 'DeskThing pairing',
        copy: 'Install the DeskThing companion, pair over your local network, and use a Car Thing as a hardware deck.',
        href: 'docs/deskthing/',
        kicker: 'Companion',
        time: '6 min',
      },
    ],
  },
];
---

<Layout
  active="docs"
  title="Documentation"
  description="ilyStream setup guides for platform connections, chat relay, audience profiles, alerts, widgets, audio, Spotify, smart lights, OBS, and DeskThing."
>
  <section class="page-hero">
    <div class="container">
      <p class="eyebrow">Documentation</p>
      <h1>Setup guides for the whole control room.</h1>
      <p class="lede">
        Hands-on guides for connecting ilyStream to live platforms, unified chat,
        audience profiles, overlays, TTS, music, smart lights, OBS, and companion devices.
        Each guide follows the same path: prerequisites, exact app steps, verification,
        and troubleshooting.
      </p>
      <div class="page-hero__actions">
        <a class="button button--primary" href={withBase('docs/getting-started/')}>Start here</a>
        <a class="button button--ghost" href={withBase('docs/platforms/')}>Platforms</a>
        <a class="button button--ghost" href={withBase('docs/chat-relay/')}>Chat relay</a>
        <a class="button button--ghost" href={withBase('docs/audience-stats/')}>Audience</a>
      </div>
    </div>
  </section>

  <section class="container section">
    {sections.map((section) => (
      <div class="docs-section">
        <h2>{section.label}</h2>
        <div class="docs-grid">
          {section.cards.map((card) => (
            <a class="doc-card" href={withBase(card.href)}>
              <div class="doc-card__head">
                <p class="tag">{card.kicker}</p>
                <p class="doc-card__time">{card.time}</p>
              </div>
              <h3>{card.title}</h3>
              <p>{card.copy}</p>
              <span class="doc-card__cta">Read guide <span aria-hidden="true">&rarr;</span></span>
            </a>
          ))}
        </div>
      </div>
    ))}
  </section>

  <section class="container section">
    <div class="cta-band">
      <div>
        <h2>Need a guide that is not here?</h2>
        <p>Open an issue on GitHub and tell us what integration you would like documented next.</p>
      </div>
      <a class="button button--ghost" href="https://github.com/ilydrw/ilyStream/issues" rel="noopener">
        Open an issue
      </a>
    </div>
  </section>
</Layout>

<style>
  .page-hero {
    padding: 64px 0 16px;
    border-bottom: 1px solid var(--line);
    background:
      radial-gradient(700px 280px at 80% 0%, rgba(167, 131, 255, 0.14), transparent 60%),
      linear-gradient(180deg, rgba(37, 199, 255, 0.08), transparent 80%);
  }
  .page-hero h1 {
    margin-top: 12px;
    font-size: clamp(2.2rem, 4.4vw, 3.4rem);
  }
  .lede {
    margin-top: 18px;
    color: var(--muted);
    font-size: 1.1rem;
    max-width: 70ch;
  }
  .page-hero__actions {
    margin-top: 26px;
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
  }

  .section { padding-top: 64px; }

  .docs-section { margin-bottom: 48px; }
  .docs-section h2 {
    margin-bottom: 18px;
    font-size: 1.2rem;
    color: var(--quiet);
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .docs-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 14px;
  }

  .doc-card {
    display: flex;
    flex-direction: column;
    padding: 24px;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background:
      linear-gradient(180deg, rgba(255, 255, 255, 0.04), rgba(255, 255, 255, 0)),
      var(--bg-raised);
    color: var(--text);
    box-shadow: var(--shadow-card);
    transition: transform 200ms ease, border-color 200ms ease;
  }
  .doc-card:hover {
    transform: translateY(-2px);
    border-color: rgba(37, 199, 255, 0.4);
  }

  .doc-card__head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 10px;
    margin-bottom: 14px;
  }

  .tag {
    color: var(--cyan);
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .doc-card__time {
    color: var(--quiet);
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.04em;
  }

  .doc-card h3 { font-size: 1.18rem; }
  .doc-card p { margin-top: 8px; color: var(--muted); }

  .doc-card__cta {
    margin-top: 18px;
    color: var(--cyan);
    font-weight: 700;
    font-size: 0.92rem;
  }

  .cta-band {
    padding: 28px;
    border: 1px solid var(--line);
    border-radius: 14px;
    background: var(--bg-raised);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    flex-wrap: wrap;
  }
  .cta-band h2 { font-size: 1.3rem; }
  .cta-band p { color: var(--muted); margin-top: 8px; }

  @media (max-width: 720px) {
    .docs-grid { grid-template-columns: 1fr; }
  }
</style>

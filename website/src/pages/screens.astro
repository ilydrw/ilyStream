---
import Layout from '../layouts/Layout.astro';
import { Image } from 'astro:assets';
import dashboardShot from '../assets/screenshots/dashboard-overview.png';
import chatShot from '../assets/screenshots/chat-hub-relay.png';
import audienceShot from '../assets/screenshots/audience-stats-profiles.png';
import studioShot from '../assets/screenshots/broadcast-studio.png';
import widgetsShot from '../assets/screenshots/widgets-overlays.png';
import alertsShot from '../assets/screenshots/alerts-routes.png';
import soundboardShot from '../assets/screenshots/soundboard.png';
import tiktokShot from '../assets/screenshots/tiktok-integration.png';
import spotifyShot from '../assets/screenshots/spotify-song-requests.png';
import aiShot from '../assets/screenshots/ai-cohost.png';
import healthShot from '../assets/screenshots/health-center.png';

const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const withBase = (path: string) => `${base}${path.replace(/^\/+/, '')}`;

const screens = [
  {
    title: 'Broadcast Dashboard',
    copy: 'Live audience, service health, speech queue, top audience, setup moves, and broadcast controls.',
    image: dashboardShot,
    alt: 'ilyStream broadcast dashboard overview.',
    wide: true,
  },
  {
    title: 'Unified Chat & Relay',
    copy: 'One chat hub for every platform with emotes, mirror controls, viewer grouping, and outbound target selection.',
    image: chatShot,
    alt: 'Unified chat hub with auto-relay and outbound message controls.',
  },
  {
    title: 'Audience Stats & Profiles',
    copy: 'Cross-platform profiles, stable platform ordering, badge priority, AI usage, and primary account selection.',
    image: audienceShot,
    alt: 'Audience stats table with platform icons, badges, and profile controls.',
  },
  {
    title: 'Health Center',
    copy: 'Platform readiness, chat tests, event tests, relay status, and actionable risks before going live.',
    image: healthShot,
    alt: 'Health Center page showing platform checkup and live checklist.',
    wide: true,
  },
  {
    title: 'TikTok Integration',
    copy: 'Live detection, sender capture, stream credentials, event feed, and platform diagnostics in one setup surface.',
    image: tiktokShot,
    alt: 'TikTok integration page with setup fields and event feed.',
  },
  {
    title: 'Broadcast Studio',
    copy: 'Scene preview, vertical composition, source list, scene switching, mixer meters, and output controls.',
    image: studioShot,
    alt: 'Broadcast Studio scene canvas and output controls.',
  },
  {
    title: 'Widgets & Overlays',
    copy: 'Browser-source widgets, overlay previews, copyable URLs, and configuration entry points.',
    image: widgetsShot,
    alt: 'Widgets and overlays page with preview cards.',
  },
  {
    title: 'Live Alerts',
    copy: 'Alert routes, platform filters, event filters, sound/image/text controls, and live preview.',
    image: alertsShot,
    alt: 'Live alerts route editor with preview and event filters.',
  },
  {
    title: 'Audio Deck',
    copy: 'Soundboard tiles, upload controls, deck overlay, and external trigger endpoints.',
    image: soundboardShot,
    alt: 'Soundboard audio deck page with sound tiles.',
  },
  {
    title: 'Spotify Song Requests',
    copy: 'Account bridge, queue controls, request filters, and command permission switches.',
    image: spotifyShot,
    alt: 'Spotify Management page with song request filters.',
  },
  {
    title: 'AI Co-Host',
    copy: 'Model endpoint, persona prompt, voice prefix, temperature, response depth, and engagement context.',
    image: aiShot,
    alt: 'AI Co-Host page with model parameters and persona editor.',
  },
];
---

<Layout
  active="screens"
  title="Screenshots - ilyStream"
  description="Fresh ilyStream screenshots covering dashboard, unified chat, audience profiles, platform setup, Health Center, Broadcast Studio, alerts, widgets, soundboard, Spotify, and AI co-host."
  image="images/dashboard-overview.png"
>
  <section class="page-hero">
    <div class="container">
      <p class="eyebrow">Screenshots</p>
      <h1>The current app, end to end.</h1>
      <p class="lede">
        These captures are from the current app and cover the workflows streamers
        actually touch: setup, chat, profiles, studio, overlays, audio, Spotify, and AI.
      </p>
      <div class="page-hero__actions">
        <a class="button button--primary" href={withBase('download/')}>Download</a>
        <a class="button button--ghost" href={withBase('features/')}>Feature breakdown</a>
      </div>
    </div>
  </section>

  <section class="container section">
    <div class="screens-grid">
      {screens.map((screen) => (
        <figure class:list={['screen-card', { 'screen-card--wide': screen.wide }]}>
          <div class="screen-card__media">
            <Image src={screen.image} alt={screen.alt} loading="lazy" decoding="async" />
          </div>
          <figcaption>
            <h2>{screen.title}</h2>
            <p>{screen.copy}</p>
          </figcaption>
        </figure>
      ))}
    </div>
  </section>
</Layout>

<style>
  .page-hero {
    padding: 72px 0 24px;
    border-bottom: 1px solid var(--line);
    background:
      radial-gradient(760px 320px at 55% 0%, rgba(36, 209, 139, 0.12), transparent 65%),
      linear-gradient(180deg, rgba(37, 199, 255, 0.08), transparent 80%);
  }

  .page-hero h1 {
    margin-top: 12px;
    font-size: clamp(2.4rem, 5vw, 4.2rem);
  }

  .lede {
    margin-top: 18px;
    color: var(--muted);
    font-size: 1.12rem;
    max-width: 70ch;
  }

  .page-hero__actions {
    margin-top: 28px;
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
  }

  .section { padding-top: 58px; }

  .screens-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 16px;
  }

  .screen-card {
    margin: 0;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--bg-raised);
    overflow: hidden;
    box-shadow: var(--shadow-card);
    transition: transform 180ms ease, border-color 180ms ease;
  }

  .screen-card:hover {
    transform: translateY(-2px);
    border-color: rgba(37, 199, 255, 0.45);
  }

  .screen-card--wide {
    grid-column: span 2;
  }

  .screen-card__media img {
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    display: block;
    border-bottom: 1px solid var(--line);
  }

  .screen-card figcaption {
    padding: 22px 24px 26px;
  }

  .screen-card h2 {
    font-size: 1.25rem;
  }

  .screen-card p {
    margin-top: 8px;
    color: var(--muted);
  }

  @media (max-width: 900px) {
    .screens-grid { grid-template-columns: 1fr; }
    .screen-card--wide { grid-column: auto; }
  }
</style>

{
  "name": "ilystream",
  "productName": "ilyStream",
  "version": "0.0.28",
  "type": "module",
  "description": "Multi-platform livestream management interface with custom TTS",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build:tiktok-bridge": "tsc -p services/tiktok-auth-bridge/tsconfig.build.json",
    "start:tiktok-bridge": "node services/tiktok-auth-bridge/dist/server.js",
    "build:virtual-camera": "powershell -ExecutionPolicy Bypass -File native/virtual-camera/build.ps1",
    "build:engine": "node scripts/build-native-engine.mjs",
    "smoke:native-audio-host": "set ELECTRON_RUN_AS_NODE=1&& electron scripts/smoke-native-audio-host.cjs",
    "build:obs-plugin": "powershell -NoProfile -ExecutionPolicy Bypass -File native/obs-plugin/scripts/build.ps1",
    "validate:obs-integration": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/obs-integration/Test-IlyStreamObsIntegration.ps1",
    "install:virtual-camera": "powershell -ExecutionPolicy Bypass -File native/virtual-camera/install.ps1",
    "uninstall:virtual-camera": "powershell -ExecutionPolicy Bypass -File native/virtual-camera/uninstall.ps1",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "postinstall": "electron-builder install-app-deps",
    "package": "node scripts/package-platform.mjs",
    "verify:package-contents": "node scripts/verify-package-contents.mjs",
    "release": "node scripts/package-platform.mjs --publish",
    "verify:native-abi": "node scripts/verify-native-abi.mjs",
    "lint": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.web.json --noEmit && tsc -p services/tiktok-auth-bridge/tsconfig.json",
    "test": "vitest run"
  },
  "build": {
    "directories": {
      "output": "dist"
    },
    "files": [
      "out/**/*",
      "package.json",
      "node_modules/**/*",
      "!node_modules/onnxruntime-node/bin/napi-v3/darwin/**/*",
      "!node_modules/onnxruntime-node/bin/napi-v3/linux/**/*",
      "!node_modules/onnxruntime-node/bin/napi-v3/win32/arm64/**/*",
      "!node_modules/onnxruntime-web/**/*",
      "!node_modules/@huggingface/transformers/.cache/**/*",
      "!node_modules/@huggingface/transformers/dist/*.map",
      "!node_modules/@huggingface/transformers/dist/ort-wasm-simd-threaded.jsep.*",
      "!node_modules/@huggingface/transformers/dist/transformers.web.*",
      "!node_modules/@huggingface/transformers/dist/transformers.min.js",
      "!node_modules/@huggingface/transformers/dist/transformers.js",
      "!node_modules/kokoro-js/voices/!(af_heart|af_bella|af_nicole|af_sarah|af_kore|af_aoede|af_alloy|af_nova|af_sky|am_fenrir|am_michael|am_puck|am_echo|am_eric|bf_emma|bf_isabella|bf_alice|bm_fable|bm_george|bm_lewis).bin",
      "!native/obs-plugin/.deps/**/*",
      "!native/obs-plugin/build/**/*",
      "!native/obs-plugin/package/**/*",
      "!resources/obs-integration/**/*",
      "!scripts/obs-integration/**/*"
    ],
    "asarUnpack": [
      "**/*.node",
      "node_modules/ffmpeg-static/**/*",
      "node_modules/onnxruntime-node/bin/napi-v3/win32/x64/**/*"
    ],
    "extraResources": [
      {
        "from": "native/engine/build/Release/ilystream_napi.node",
        "to": "native-engine/ilystream_napi.node"
      },
      {
        "from": "native/engine/build/Release/ilystream_preview.node",
        "to": "native-engine/ilystream_preview.node"
      },
      {
        "from": "native/engine/build/Release/ilystream_engine.dll",
        "to": "native-engine/ilystream_engine.dll"
      },
      {
        "from": "native/engine/build/Release/ilystream_core_host.exe",
        "to": "native-engine/ilystream_core_host.exe"
      },
      {
        "from": "native/engine/build/Release/ilystream_audio.node",
        "to": "native-audio/ilystream_audio.node"
      },
      {
        "from": "resources/ilyStream-Logo.svg",
        "to": "ilystream-logo.svg"
      },
      {
        "from": "resources/ilyStream-AppIcon.ico",
        "to": "ilyStream-AppIcon.ico"
      },
      {
        "from": "resources/companion-emojis",
        "to": "companion-emojis"
      },
      {
        "from": "native/virtual-camera/bin/x64/Release/IlyStreamVirtualCameraRegistrar.exe",
        "to": "native/virtual-camera/IlyStreamVirtualCameraRegistrar.exe"
      },
      {
        "from": "native/virtual-camera/bin/x64/Release/IlyStreamVirtualCameraBridge.exe",
        "to": "native/virtual-camera/IlyStreamVirtualCameraBridge.exe"
      },
      {
        "from": "native/virtual-camera/bin/x64/Release/VirtualCameraMediaSource.dll",
        "to": "native/virtual-camera/VirtualCameraMediaSource.dll"
      },
      {
        "from": "native/virtual-camera/install.ps1",
        "to": "native/virtual-camera/install.ps1"
      },
      {
        "from": "native/virtual-camera/uninstall.ps1",
        "to": "native/virtual-camera/uninstall.ps1"
      },
      {
        "from": "resources/obs-integration",
        "to": "obs-integration"
      },
      {
        "from": "scripts/obs-integration",
        "to": "obs-integration/scripts"
      },
      {
        "from": "native/obs-plugin/package/obs-plugin",
        "to": "obs-integration/native-plugin"
      }
    ],
    "win": {
      "icon": "resources/ilyStream-AppIcon.ico",
      "extraResources": [
        {
          "from": "native/engine/build/Release/ilystream_native_ui.exe",
          "to": "native-engine/ilystream_native_ui.exe"
        }
      ],
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "mac": {
      "extraResources": [
        {
          "from": "native/engine/build/ilystream_native_ui",
          "to": "native-engine/ilystream_native_ui"
        }
      ]
    },
    "linux": {
      "extraResources": [
        {
          "from": "native/engine/build/ilystream_native_ui",
          "to": "native-engine/ilystream_native_ui"
        }
      ]
    },
    "nsis": {
      "artifactName": "ilyStream-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "ilyStream-Portable-${version}.${ext}"
    }
  },
  "dependencies": {
    "@huggingface/transformers": "^3.8.1",
    "@twurple/api": "^8.1.3",
    "@twurple/auth": "^8.1.3",
    "@twurple/chat": "^8.1.3",
    "@twurple/eventsub-ws": "^8.1.3",
    "better-sqlite3": "^12.9.0",
    "discord-rpc": "^4.0.1",
    "electron-log": "^5.4.0",
    "electron-updater": "^6.8.9",
    "ffmpeg-static": "^5.3.0",
    "kokoro-js": "^1.2.1",
    "matter-js": "0.19.0",
    "obs-websocket-js": "^5.0.8",
    "onnxruntime-node": "1.21.0",
    "tiktok-live-connector": "2.1.1-beta1",
    "ws": "^8.20.1"
  },
  "overrides": {
    "axios": "^1.20.0",
    "js-yaml": "^4.3.1",
    "sharp": "^0.35.4",
    "tar": "^7.5.22",
    "tiktok-live-connector": {
      "protobufjs": "^8.8.0"
    }
  },
  "devDependencies": {
    "@electron-toolkit/preload": "^3.0.1",
    "@electron-toolkit/utils": "^4.0.0",
    "@tabler/icons-react": "^3.44.0",
    "@tailwindcss/vite": "^4.1.3",
    "@types/better-sqlite3": "^7.6.13",
    "@types/discord-rpc": "^4.0.11",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.4.1",
    "clsx": "^2.1.1",
    "electron": "^41.5.1",
    "electron-builder": "^26.0.0",
    "electron-vite": "^3.0.0",
    "framer-motion": "^12.38.0",
    "node-addon-api": "^8.7.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.5.0",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.1.3",
    "typescript": "^5.8.3",
    "vite": "^6.3.1",
    "vitest": "^3.1.1",
    "zustand": "^5.0.3"
  }
}
